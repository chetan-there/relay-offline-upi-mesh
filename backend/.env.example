# Copy to backend/.env and fill in your local MySQL credentials. Never commit backend/.env.
# Create the database first: CREATE DATABASE upimesh CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# URL-encode special characters in your password (@ : / # ?).


# Optional MySQL integration-test database (must include "test" in its name).
# TEST_DATABASE_URL=mysql+pymysql://upimesh_user:CHANGE_ME@localhost:3306/upimesh_test
